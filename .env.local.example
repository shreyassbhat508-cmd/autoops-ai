# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-KEEP-SECRET

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twilio (for SMS/WhatsApp reminders and, later, the voice booking agent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
# "sms" or "whatsapp" — which channel the recovery agent sends through
TWILIO_MESSAGING_CHANNEL=sms
# Default country code prefix used when a customer_phone doesn't already
# start with "+". Change if your customers aren't primarily Indian numbers.
DEFAULT_COUNTRY_CODE=+91
